<mvc:View displayBlock="true" controllerName="sapui5flightlk.controller.FlightDetails" height="100%"
		xmlns="sap.uxap"
		xmlns:mvc="sap.ui.core.mvc"
		xmlns:m="sap.m"
		xmlns:form="sap.ui.layout.form">

	<ObjectPageLayout id="ObjectPageLayout"
			showTitleInHeaderContent="true"
			alwaysShowContentHeader="false"
			preserveHeaderStateOnScroll="false"
			headerContentPinnable="true"
			isChildPage="true"
			upperCaseAnchorBar="false">
		<headerTitle>
			<ObjectPageDynamicHeaderTitle id="_IDGenObjectPageDynamicHeaderTitle1">
				<expandedHeading>
					<m:Title id="_IDGenTitle2" text="{flightDetailsModel>/Carrname}" wrapping="true" class="sapUiSmallMarginEnd"/>
				</expandedHeading>

				<snappedHeading>
					<m:FlexBox id="_IDGenFlexBox" wrap="Wrap" fitContainer="true" alignItems="Center">
						<m:FlexBox id="_IDGenFlexBox1" wrap="NoWrap" fitContainer="true" alignItems="Center" class="sapUiTinyMarginEnd">
							<m:Title id="_IDGenTitle3" text="{flightDetailsModel>/Carrname}" wrapping="true" class="sapUiTinyMarginEnd"/>
						</m:FlexBox>
					</m:FlexBox>
				</snappedHeading>

				<navigationActions>
					<m:OverflowToolbarButton id="_IDGenOverflowToolbarButton" type="Transparent" icon="sap-icon://full-screen" press="handleFullScreen" tooltip="Enter Full Screen Mode" visible="{= ${/actionButtonsInfo/midColumn/fullScreen} !== null }"/>
					<m:OverflowToolbarButton id="_IDGenOverflowToolbarButton1" type="Transparent" icon="sap-icon://exit-full-screen" press="handleExitFullScreen" tooltip="Exit Full Screen Mode" visible="{= ${/actionButtonsInfo/midColumn/exitFullScreen} !== null }"/>
					<m:OverflowToolbarButton id="_IDGenOverflowToolbarButton2" type="Transparent" icon="sap-icon://decline" press="handleClose"  tooltip="Close column" visible="{= ${/actionButtonsInfo/midColumn/closeColumn} !== null }"/>
				</navigationActions>

			</ObjectPageDynamicHeaderTitle>
		</headerTitle>

		<headerContent>
			<m:FlexBox id="_IDGenFlexBox2" wrap="Wrap" fitContainer="true" alignItems="Stretch">
				<m:Avatar id="_IDGenAvatar7" src="{path: 'flightDetailsModel>/Carrid', formatter:'.formatter.getCarrierLogo'}"
					displaySize="L"
					displayShape="Square"
					class="sapUiTinyMarginEnd">
				</m:Avatar>				
				<m:VBox id="_IDGenVBox1" justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label id="_IDGenLabel" text="Airline ID"/>
					<m:Text id="_IDGenText22" text="{flightDetailsModel>/Carrid}"/>
				</m:VBox>
				<m:VBox id="_IDGenVBox2" justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label id="_IDGenLabel1" text="URL"/>
					<m:Text id="_IDGenText31"
  						text="{= ${flightDetailsModel>/Url} ? ${flightDetailsModel>/Url} : 'www.' + (${flightDetailsModel>/Carrname} || '').split(' ').join('') + '.com' }"/>
				</m:VBox>
				<m:VBox id="_IDGenVBox3" justifyContent="Center" class="sapUiSmallMarginEnd">
					<m:Label id="_IDGenLabel2" text="Currency"/>
					<m:ObjectNumber id="_IDGenObjectNumber" number="{flightDetailsModel>/Currcode}" emphasized="false"/>
				</m:VBox>
			</m:FlexBox>
		</headerContent>

		<sections>
			<ObjectPageSection id="_IDGenObjectPageSection" title="Flight Information">
				<subSections>
					<ObjectPageSubSection id="_IDGenObjectPageSubSection">
						<blocks>
							<m:Table
							id="flightDetailsTable"
							items="{path: 'flightDetailsModel>/to_FlightDetailsLOR/results'}">

							<m:headerToolbar>
								<m:OverflowToolbar id="_IDGenOverflowToolbar">
									<m:Title id="_IDGenTitle" text="Flight Details" level="H2"/>
									<m:ToolbarSpacer id="_IDGenToolbarSpacer"/>
								</m:OverflowToolbar>
							</m:headerToolbar>

							<m:columns>
								<m:Column id="_IDGenColumn1" minScreenWidth="Tablet" demandPopin="true"><m:Text id="_IDGenText1" text="{i18n>connid}"/></m:Column>
								<m:Column id="_IDGenColumn2" minScreenWidth="Tablet" demandPopin="true"><m:Text id="_IDGenText2" text="{i18n>fldate}"/></m:Column>
								<m:Column id="_IDGenColumn3" minScreenWidth="Desktop" demandPopin="true"><m:Text id="_IDGenText3" text="{i18n>airfare}"/></m:Column>
								<m:Column id="_IDGenColumn4" minScreenWidth="Desktop" demandPopin="true"><m:Text id="_IDGenText4" text="{i18n>airlineLocalCurrency}"/></m:Column>
								<m:Column id="_IDGenColumn15"  minScreenWidth="Desktop" demandPopin="true"><m:Text id="_IDGenText"  text="{i18n>planetype}"/></m:Column>
								<m:Column id="_IDGenColumn5" minScreenWidth="Desktop" demandPopin="true"><m:Text id="_IDGenText5" text="{i18n>maxTypeEco}"/></m:Column>
								<m:Column id="_IDGenColumn6"  minScreenWidth="Desktop" demandPopin="true"><m:Text id="_IDGenText6"  text="{i18n>occSeatsEco}"/></m:Column>
								<m:Column id="_IDGenColumn7"  minScreenWidth="Desktop" demandPopin="true"><m:Text id="_IDGenText8"  text="{i18n>maxTypeBsns}"/></m:Column>
								<m:Column id="_IDGenColumn11"  minScreenWidth="Desktop" demandPopin="true"><m:Text id="_IDGenText20"  text="{i18n>occSeatsBsns}"/></m:Column>
								<m:Column id="_IDGenColumn12"  minScreenWidth="Desktop" demandPopin="true"><m:Text id="_IDGenText29"  text="{i18n>maxTypeFrst}"/></m:Column>
								<m:Column id="_IDGenColumn13"  minScreenWidth="Desktop" demandPopin="true"><m:Text id="_IDGenText30"  text="{i18n>occSeatsFrst}"/></m:Column>
								<m:Column id="_IDGenColumn14"  hAlign="End"><m:Text id="_IDGenText7" text="Total Payment Sum"/></m:Column>
								<m:Column id="_IDGenColumnDelete" hAlign="Center" width="4rem">
									<m:Text id="_IDGenText32" text="Delete" />
								</m:Column>
							</m:columns>

							<m:items>
								<m:ColumnListItem id="_IDGenColumnListItem" highlight="{= ${flightDetailsModel>SeatsOcc} > 180 ? 'Success' : 'Error' }">
									<m:cells>
										<m:Text id="_IDGenText9" text="{flightDetailsModel>Connid}" />
										<m:Text id="_IDGenText10" text="{path: 'flightDetailsModel>Fldate', formatter:'.formatter.formatDate'}" wrapping="false"/>
										<m:Text id="_IDGenText11" text="{flightDetailsModel>Price}" />
										<m:Text id="_IDGenText12" text="{flightDetailsModel>Currency}" />
										<m:Text id="_IDGenText13" text="{flightDetailsModel>PlaneType}" />
										<m:Text id="_IDGenText23" text="{flightDetailsModel>SeatsMax}" />
										<m:Text id="_IDGenText24" text="{flightDetailsModel>SeatsOcc}" />
										<m:Text id="_IDGenText25" text="{flightDetailsModel>SeatsmaxB}" />
										<m:Text id="_IDGenText26" text="{flightDetailsModel>SeatsoccB}" />
										<m:Text id="_IDGenText27" text="{flightDetailsModel>SeatsmaxF}" />
										<m:Text id="_IDGenText28" text="{flightDetailsModel>SeatsoccF}" />
										<m:Text id="_IDGenText21" text="{flightDetailsModel>PaymentSum}" />
										<m:Button id="_IDGenButton2" 
											icon="sap-icon://delete" 
											type="Reject" 
											press=".onDeleteDetail" />
									</m:cells>
								</m:ColumnListItem>
							</m:items>
						</m:Table>
						</blocks>
					</ObjectPageSubSection>
				</subSections>
			</ObjectPageSection>
		</sections>
	</ObjectPageLayout>
</mvc:View>