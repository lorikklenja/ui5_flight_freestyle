<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
	
    <Dialog id="editAirlineDialog" title="Edit Airline">

        <content>
            <form:SimpleForm
                id="editFormDialog"
                editable="true">

                <form:content>

                    <Label id="_IDGenLabel4" text="{i18n>carrid}" />
                    <Input id="_IDGenInput" value="{flightDataModel>Carrid}" editable="false" />

                    <Label id="_IDGenLabel5" text="{i18n>carrname}" />
                    <Input id="_IDGenInput1" value="{flightDataModel>Carrname}" />

                    <Label id="_IDGenLabel6" text="{i18n>airlineLocalCurrency}" />
                    <Input id="_IDGenInput2" value="{flightDataModel>Currcode}" />

                    <Label id="_IDGenLabel7" text="{i18n>url}" />
                    <Input id="_IDGenInput3" value="{flightDataModel>Url}" />

                </form:content>
            </form:SimpleForm>
        </content>

        <beginButton>
            <Button id="_IDGenButton" text="Save" press=".onSaveEditRecord" />
        </beginButton>

        <endButton>
            <Button id="_IDGenButton1" text="Cancel" press=".onCancelEditRecord" />
        </endButton>

    </Dialog>
</core:FragmentDefinition>
